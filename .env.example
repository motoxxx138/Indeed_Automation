# OpenRouter API Key (Get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model choices on OpenRouter: google/gemini-2.5-flash, anthropic/claude-3.5-sonnet, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct, etc.
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Browser Selection ('firefox' or 'chromium')
BROWSER_TYPE=firefox

# Job Search Settings
JOB_SEARCH_QUERY=remote customer service
JOB_LOCATION=remote
SEARCH_INTERVAL_MINUTES=15

# Your Profile Information (Used for Indeed contact details & screening questions)
USER_FULL_NAME=Jane Doe
USER_EMAIL=jane.doe@example.com
USER_PHONE=555-123-4567
USER_CITY=Dallas
USER_STATE=TX
USER_ZIP=75001
USER_EXP_YEARS=5
USER_SALARY=22
